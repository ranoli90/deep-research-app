    "expo-file-system": "19.0.24",
    "expo-secure-store": "15.0.8",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-safe-area-context": "^5.6.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
