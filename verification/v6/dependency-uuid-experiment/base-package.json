{
  "name": "deep-research-mobile",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "doctor": "pnpm --filter @deep/backend doctor",
    "dev:demo": "pnpm --filter @deep/backend dev:demo",
    "dev:live": "pnpm --filter @deep/backend dev:live",
    "db:migrate": "pnpm --filter @deep/backend db:migrate",
    "db:seed:demo": "pnpm --filter @deep/backend db:seed:demo",
    "lint": "pnpm --filter @deep/backend lint && pnpm --filter @deep/research-core lint && pnpm --filter @deep/contracts lint",
    "typecheck": "pnpm -r --filter \"./packages/*\" --filter @deep/backend typecheck",
    "test:unit": "pnpm --filter @deep/research-core test && pnpm --filter @deep/backend test:unit && pnpm --filter @deep/mobile test",
    "test:integration": "pnpm --filter @deep/backend test:integration",
    "test:e2e:ios": "node scripts/e2e-ios.mjs",
    "test:e2e:android": "node scripts/e2e-android.mjs",
    "eval:fixture": "pnpm --filter @deep/backend eval:fixture",
    "eval:live": "pnpm --filter @deep/backend eval:live",
    "p0:launch": "tsx scripts/p0-launch-check.ts",
    "verify": "pnpm typecheck && pnpm test:unit && node scripts/check-boundaries.mjs && pnpm --filter @deep/backend test:governance",
    "build": "pnpm -r --filter \"./packages/*\" --filter @deep/backend build",
    "compose:up": "sudo docker compose up -d --wait",
    "compose:down": "sudo docker compose down"
  },
  "pnpm": {
    "overrides": {
      "@expo/metro-config>postcss": "8.5.28",
      "@expo/metro>metro": "0.83.8",
      "@expo/metro>metro-babel-transformer": "0.83.8",
      "@expo/metro>metro-cache": "0.83.8",
      "@expo/metro>metro-cache-key": "0.83.8",
      "@expo/metro>metro-config": "0.83.8",
      "@expo/metro>metro-core": "0.83.8",
      "@expo/metro>metro-file-map": "0.83.8",
      "@expo/metro>metro-minify-terser": "0.83.8",
      "@expo/metro>metro-resolver": "0.83.8",
      "@expo/metro>metro-runtime": "0.83.8",
      "@expo/metro>metro-source-map": "0.83.8",
      "@expo/metro>metro-symbolicate": "0.83.8",
      "@expo/metro>metro-transform-plugins": "0.83.8",
      "@expo/metro>metro-transform-worker": "0.83.8"
    }
  }
}
