NODE_ENV=development
DATABASE_URL=postgres://deep:deep_local_dev_only@127.0.0.1:55432/deep_research
TEST_DATABASE_URL=postgres://deep:deep_local_dev_only@127.0.0.1:55432/deep_research_test
APP_AUTH_MODE=development
# Production requires this project's HTTPS origin and publishable key; never a service-role/secret key.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
DEV_ALLOW_FIXTURE_ROUTE=true
LIVE_ROUTE_ENABLED=false
STRUCTURED_MODEL_ENABLED=false
# Explicit disclosed alternative: openrouter-azure-mini-zdr-text-v1. Existing runs retain their admitted policy.
STRUCTURED_MODEL_POLICY_ID=openrouter-openai-mini-text-v1
# Pinned public discovery remains opt-in; requires current processor consent and authorized caps.
STRUCTURED_DISCOVERY_ENABLED=false
LIVE_RETRIEVAL_ENABLED=false
LIVE_SPEND_CAP_MICRO=0
# Independent credential-wide cap; legacy unattributed intents count conservatively.
LIVE_KEY_SPEND_CAP_MICRO=0
# OPENROUTER_API_KEY=  # server-only; never put this in the mobile app
API_HOST=127.0.0.1
API_PORT=8787
WORKER_ID=local-worker-1
LEASE_MS=30000
STORAGE_DIR=./apps/backend/data/storage
OPENROUTER_MODEL=openai/gpt-4o-mini
