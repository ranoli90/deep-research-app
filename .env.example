NODE_ENV=development
# Local Docker Compose Postgres (host port 55432). Not hosted Supabase.
DATABASE_URL=postgres://deep:deep_local_dev_only@127.0.0.1:55432/deep_research
TEST_DATABASE_URL=postgres://deep:deep_local_dev_only@127.0.0.1:55432/deep_research_test
APP_AUTH_MODE=development
DEV_ALLOW_FIXTURE_ROUTE=true
LIVE_ROUTE_ENABLED=false
API_HOST=127.0.0.1
API_PORT=8787
WORKER_ID=local-worker-1
LEASE_MS=30000
STORAGE_DIR=./data/storage
# Required only for P0-L / pnpm eval:live / pnpm dev:live. Never put these in the mobile bundle.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# LIVE_RETRIEVAL_ENABLED=false
# Operator live spend cap in USD micro-units (1 USD = 1_000_000).
LIVE_SPEND_CAP_MICRO=0
