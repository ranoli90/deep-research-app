# Only the backend workspace and its declared local packages enter the build
# context. Dockerfile COPY statements must stay within this allowlist.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!apps
!apps/backend
!apps/backend/**
!packages
!packages/contracts
!packages/contracts/**
!packages/research-core
!packages/research-core/**
!packages/design
!packages/design/**
!deployment
!deployment/render
!deployment/render/**

# A future credential accidentally placed below an allowed directory remains
# excluded. No mobile directory is in the allowlist at all.
**/.env
**/.env.*
**/.credentials
**/.credentials/**
**/credentials.json
**/.npmrc
**/.netrc
**/*.p8
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/node_modules
**/node_modules/**
**/data
**/data/**
**/coverage
**/coverage/**
**/dist
**/dist/**
**/build
**/build/**
**/*.log
